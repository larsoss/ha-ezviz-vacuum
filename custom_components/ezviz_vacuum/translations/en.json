  "services": {
    "inspect": {
      "name": "Inspect robot",
      "description": "Returns sanitized device data for protocol diagnostics.",
      "fields": {
        "serial": {
          "name": "Robot serial",
          "description": "Serial number of the robot. Leave empty to use the first configured robot."
        }
      }
    },
    "map_diagnostics": {
      "name": "Inspect robot map",
      "description": "Tests read-only map and route access without controlling the robot.",
      "fields": {
        "serial": {
          "name": "Robot serial",
          "description": "Serial number of the robot. Leave empty to use the first configured robot."
        }
      }
    },
    "camera_diagnostics": {
      "name": "Inspect robot camera",
      "description": "Opens a short transport diagnostic without saving an image.",
      "fields": {
        "serial": {
          "name": "Robot serial",
          "description": "Serial number of the robot. Leave empty to use the first configured robot."
        }
      }
    },
    "refresh_camera_snapshot": {
      "name": "Capture robot camera snapshot",
      "description": "Opens the camera briefly, stores one frame in memory and closes the stream.",
      "fields": {
        "serial": {
          "name": "Robot serial",
          "description": "Serial number of the robot. Leave empty to use the first configured robot."
        }
      }
    },
    "feature_request": {
      "name": "Send raw feature request",
      "description": "Admin only. Sends one GET or PUT to the robot's cloud feature/action endpoint and returns the raw response. For protocol discovery; a wrong PUT can change robot settings.",
      "fields": {
        "method": {
          "name": "Method",
          "description": "GET reads a value, PUT writes it."
        },
        "endpoint": {
          "name": "Endpoint",
          "description": "'feature' for settings, 'action' for commands."
        },
        "domain": {
          "name": "Domain",
          "description": "Feature domain, for example SweeperCleanTask."
        },
        "identifier": {
          "name": "Identifier",
          "description": "Feature or action name, for example CarpetCleanCfg."
        },
        "payload": {
          "name": "Payload",
          "description": "JSON body for PUT requests."
        },
        "resource": {
          "name": "Resource",
          "description": "Resource identifier, default SweepingRobot."
        },
        "local_index": {
          "name": "Local index",
          "description": "Resource channel, default 0."
        },
        "serial": {
          "name": "Robot serial",
          "description": "Serial number of the robot. Leave empty to use the first configured robot."
        }
      }
    },
    "api_request": {
      "name": "Send raw API request",
      "description": "Admin only. Sends one request to the EZVIZ API host used by the account session and returns the response. For protocol discovery.",
      "fields": {
        "method": {
          "name": "Method",
          "description": "HTTP method."
        },
        "path": {
          "name": "Path",
          "description": "Path on the EZVIZ API host, starting with '/'."
        },
        "params": {
          "name": "Query parameters",
          "description": "Optional query string parameters."
        },
        "data": {
          "name": "Form data",
          "description": "Optional form body."
        },
        "serial": {
          "name": "Robot serial",
          "description": "Serial number of the robot. Leave empty to use the first configured robot."
        },
        "json": {
          "name": "JSON body",
          "description": "Optional JSON request body."
        },
        "headers": {
          "name": "Headers",
          "description": "Optional extra request headers."
        }
      }
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
          "room_devices": "Room devices"
        },
        "data_description": {
          "room_devices": "Show each room's settings (suction, water level, passes) as a device of its own, linked to the robot, instead of on the robot's page."
        }
      }
    }
  }
